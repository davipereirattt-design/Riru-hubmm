--// ==========================================
--// MECÂNICAS: TP BYPASS REFORÇADO E ATAQUE
--// ==========================================
local FloorPart = Instance.new("Part")
FloorPart.Name = "HubSafeFloor"
FloorPart.Size = Vector3.new(24, 1, 24)
FloorPart.Transparency = 1
FloorPart.Anchored = true
FloorPart.CanCollide = true
FloorPart.Parent = Workspace

table.insert(ActiveConnections, RunService.Stepped:Connect(function()
	if not ActiveRunning then return end
	local char, _, hrp = GetCharParts()
	if getgenv().HubConfig.AutoFarm and char and hrp then
		for _, part in ipairs(char:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
			end
		end
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		FloorPart.CFrame = hrp.CFrame * CFrame.new(0, -3.5, 0)
	else
		FloorPart.CFrame = CFrame.new(0, -500, 0)
	end
end))

local function DirectTeleport(targetCFrame)
	local char, hum, hrp = GetCharParts()
	if not char or not hrp or not targetCFrame then return end

	local dist = (hrp.Position - targetCFrame.Position).Magnitude
	if dist < 1.5 then return end

	pcall(function()
		if hum then
			if hum.Sit then hum.Sit = false end
			hum:ChangeState(Enum.HumanoidStateType.Running)
		end
		if dist > 80 and (os.clock() - LastTpTime > 0.35) then
			LastTpTime = os.clock()
			if LocalPlayer.RequestStreamAroundAsync then
				LocalPlayer:RequestStreamAroundAsync(targetCFrame.Position)
			end
		end
	end)

	for _, part in ipairs(char:GetDescendants()) do
		if part:IsA("BasePart") then
			part.AssemblyLinearVelocity = Vector3.zero
			part.AssemblyAngularVelocity = Vector3.zero
		end
	end

	local pivoted = false
	pcall(function()
		char:PivotTo(targetCFrame)
		pivoted = true
	end)

	if not pivoted or (hrp.Position - targetCFrame.Position).Magnitude > 12 then
		pcall(function()
			hrp.CFrame = targetCFrame
		end)
	end
end

local function EquipSelectedStyle()
	local char, hum = GetCharParts()
	if not char or not hum then return nil end
	local wanted = getgenv().HubConfig.CombatStyle
	local current = char:FindFirstChildOfClass("Tool")

	local function matches(tool)
		local n = tool.Name:lower()
		local tip = (tool.ToolTip or ""):lower()
		if wanted == "Sword" then
			return n:find("sword") or n:find("katana") or n:find("blade") or n:find("yoru") or n:find("saber") or n:find("bisento") or n:find("scythe") or tip:find("sword")
		else
			return n:find("combat") or n:find("melee") or n:find("fist") or n:find("step") or n:find("karate") or n:find("claw") or n:find("dragon") or n:find("punch") or tip:find("melee") or tip:find("fighting")
		end
	end

	if current and matches(current) then
		return current
	end

	local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
	if backpack then
		for _, tool in ipairs(backpack:GetChildren()) do
			if tool:IsA("Tool") and matches(tool) then
				pcall(function() hum:EquipTool(tool) end)
				return tool
			end
		end
	end

	return current
end

local function GetAttackRemotes()
	if os.clock() - LastRemoteRefresh < 8 then
		return CachedRemotes
	end
	LastRemoteRefresh = os.clock()
	local list = {}
	for _, rem in ipairs(ReplicatedStorage:GetDescendants()) do
		if rem:IsA("RemoteEvent") then
			local rName = rem.Name:lower()
			if rName:find("combat") or rName:find("attack") or rName:find("hit") or rName:find("m1") or rName:find("swing") or rName:find("punch") or rName:find("slash") then
				table.insert(list, rem)
			end
		end
	end
	CachedRemotes = list
	return CachedRemotes
end

local function GetRangedAttackCFrame(targetHRP, extraHeight)
	local _, _, hrp = GetCharParts()
	local rangeDist = math.clamp(tonumber(getgenv().HubConfig.RangeSize) or 450, 15, 450)
	local hOffset = extraHeight or 2.5

	if getgenv().HubConfig.RangeEnabled then
		local dir = Vector3.zero
		if hrp then
			dir = hrp.Position - targetHRP.Position
			dir = Vector3.new(dir.X, 0, dir.Z)
		end
		if dir.Magnitude < 0.01 then
			dir = targetHRP.CFrame.RightVector
		end
		local standPos = targetHRP.Position + (dir.Unit * rangeDist) + Vector3.new(0, hOffset, 0)
		return CFrame.lookAt(standPos, targetHRP.Position)
	end

	local sidePos = (targetHRP.CFrame * CFrame.new(getgenv().HubConfig.SideOffset, hOffset, 0)).Position
	return CFrame.lookAt(sidePos, targetHRP.Position)
end

local function ExecuteAttack(targetEntry)
	local char, _, hrp = GetCharParts()
	if not char then return end
	local tool = EquipSelectedStyle() or char:FindFirstChildOfClass("Tool")

	if tool then
		pcall(function() tool:Activate() end)
		for _, child in ipairs(tool:GetChildren()) do
			if child:IsA("RemoteEvent") then
				pcall(function() child:FireServer() end)
				if targetEntry and targetEntry.hrp then
					pcall(function() child:FireServer(targetEntry.hrp.Position, targetEntry.model) end)
				end
			end
		end
	end

	local remotes = GetAttackRemotes()
	local maxRange = getgenv().HubConfig.RangeEnabled and (tonumber(getgenv().HubConfig.RangeSize) or 450) or 25

	for _, rem in ipairs(remotes) do
		pcall(function() rem:FireServer(getgenv().HubConfig.CombatStyle) end)
		if targetEntry and targetEntry.hrp and hrp then
			local dist = (hrp.Position - targetEntry.hrp.Position).Magnitude
			if dist <= maxRange then
				pcall(function() rem:FireServer(targetEntry.model, targetEntry.hrp.CFrame, maxRange) end)
				pcall(function() rem:FireServer(targetEntry.hrp.Position, maxRange) end)
			end
		end
	end
end

task.spawn(function()
	while ActiveRunning do
		task.wait(0.14)
		if getgenv().HubConfig.AutoAttack then
			ExecuteAttack(nil)
		end
	end
end)

local function GetOtherIslandTargetCF(selected)
	for _, selName in ipairs(selected) do
		if KnownMobPositions[selName] then
			return KnownMobPositions[selName] * CFrame.new(0, 5, 0)
		end
	end

	for _, obj in ipairs(Workspace:GetDescendants()) do
		if obj:IsA("BasePart") then
			local ln = obj.Name:lower()
			for _, selName in ipairs(selected) do
				if ln:find(selName:lower(), 1, true) then
					return obj.CFrame * CFrame.new(0, 5, 0)
				end
			end
		end
	end

	local spot = FallbackIslandScanSpots[IslandProbeIndex]
	IslandProbeIndex = (IslandProbeIndex % #FallbackIslandScanSpots) + 1
	return spot
end

local function MatchesSelectedMob(mobName)
	local lowerMob = mobName:lower()
	for _, sel in ipairs(getgenv().HubConfig.SelectedMobs) do
		local lowerSel = sel:lower()
		if lowerMob == lowerSel then
			return true
		end
		if getgenv().HubConfig.FarmAllNearby then
			local baseSel = lowerSel:gsub("%d+$", "")
			local baseMob = lowerMob:gsub("%d+$", "")
			if #baseSel >= 4 and baseSel == baseMob then
				return true
			end
		end
	end
	return false
end

local function GetNextSelectedTarget()
	local selected = getgenv().HubConfig.SelectedMobs
	local _, _, hrp = GetCharParts()
	if #selected == 0 or not hrp then
		return nil, nil
	end

	local aliveMap = ScanWorldMobs(false)
	local bestEntry = nil
	local bestDist = math.huge

	for _, selName in ipairs(selected) do
		local list = aliveMap[selName]
		if list then
			for _, entry in ipairs(list) do
				if entry.model.Parent and entry.hrp.Parent and entry.hum.Health > 0 then
					KnownMobPositions[selName] = entry.hrp.CFrame
					local d = (hrp.Position - entry.hrp.Position).Magnitude
					if d < bestDist then
						bestDist = d
						bestEntry = entry
					end
				end
			end
		end

		if getgenv().HubConfig.FarmAllNearby then
			local baseSel = selName:gsub("%d+$", ""):lower()
			if #baseSel >= 4 then
				for mobName, listGroup in pairs(aliveMap) do
					if MatchesSelectedMob(mobName) then
						for _, entry in ipairs(listGroup) do
							if entry.model.Parent and entry.hrp.Parent and entry.hum.Health > 0 then
								local d = (hrp.Position - entry.hrp.Position).Magnitude
								if d < bestDist then
									bestDist = d
									bestEntry = entry
								end
							end
						end
					end
				end
			end
		end
	end

	if bestEntry then
		return bestEntry, nil
	end

	if getgenv().HubConfig.TpBypass then
		return nil, GetOtherIslandTargetCF(selected)
	end

	return nil, nil
end

task.spawn(function()
	while ActiveRunning do
		task.wait(0.14)
		pcall(function()
			local char, _, hrp = GetCharParts()
			if not char or not hrp then return end

			if getgenv().HubConfig.AutoFarm then
				EquipSelectedStyle()
				local entry, nextIslandCF = GetNextSelectedTarget()

				if entry and entry.hrp and entry.hrp.Parent then
					local finalCF = GetRangedAttackCFrame(entry.hrp, 2.5)
					DirectTeleport(finalCF)
					ExecuteAttack(entry)
				elseif nextIslandCF and getgenv().HubConfig.TpBypass then
					DirectTeleport(nextIslandCF)
				end
			end
		end)
	end
end)

