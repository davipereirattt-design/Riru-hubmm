--// Carrega Rayfield UI
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

--// Serviços
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local LocalPlayer = Players.LocalPlayer

--// Limpa instância anterior se o script for reexecutado
if getgenv().SailorHubCleanup then
	pcall(getgenv().SailorHubCleanup)
end

local ActiveConnections = {}
local ActiveRunning = true

getgenv().SailorHubCleanup = function()
	ActiveRunning = false
	for _, conn in ipairs(ActiveConnections) do
		pcall(function() conn:Disconnect() end)
	end
	table.clear(ActiveConnections)
	local oldFloor = Workspace:FindFirstChild("HubSafeFloor")
	if oldFloor then oldFloor:Destroy() end
end

local function GetCharParts()
	local char = LocalPlayer.Character
	if not char then return nil, nil, nil end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
	return char, hum, hrp
end

--// Pontos de varredura de ilhas caso mob de outra ilha ainda não tenha carregado
local FallbackIslandScanSpots = {
	CFrame.new(0, 45, 0),
	CFrame.new(1200, 45, 900),
	CFrame.new(-1200, 45, 900),
	CFrame.new(1500, 45, -1100),
	CFrame.new(-1500, 45, -1100),
	CFrame.new(0, 45, 2000),
	CFrame.new(0, 45, -2000)
}

--// Configurações Globais
getgenv().HubConfig = {
	AutoFarm = false,
	FarmAllNearby = true,
	SelectedMobs = {},
	CombatStyle = "Melee",
	AutoAttack = false,
	RangeEnabled = true,
	RangeSize = 450,
	SideOffset = 4.5,
	TpBypass = true
}

local LabelToRealName = {}
local KnownMobPositions = {}
local KnownMobLevels = {}
local UniqueMobSet = {}
local CachedAliveByName = {}
local CachedRemotes = {}
local LastMobScan = 0
local LastRemoteRefresh = 0
local LastTpTime = 0
local IslandProbeIndex = 1

local IgnoredKeywords = {
	"dummy", "damage", "dmg", "test", "testing", "training", "train",
	"dps", "target", "bag", "punching", "shop", "quest", "vendor"
}

local function IsIgnoredModel(obj)
	if not obj then return true end
	local n = obj.Name:lower()
	for _, word in ipairs(IgnoredKeywords) do
		if n:find(word, 1, true) then
			return true
		end
	end
	local parent = obj.Parent
	if parent and parent ~= Workspace then
		local pn = parent.Name:lower()
		for _, word in ipairs(IgnoredKeywords) do
			if pn:find(word, 1, true) then
				return true
			end
		end
	end
	return false
end

local function GetScanRoots()
	local roots = {}
	for _, folderName in ipairs({"Enemies", "Mobs", "Monsters"}) do
		local folder = Workspace:FindFirstChild(folderName)
		if folder then
			table.insert(roots, folder)
		end
	end
	if #roots == 0 then
		table.insert(roots, Workspace)
	end
	return roots
end

local function ExtractMobLevel(model, hum)
	for _, attrName in ipairs({"Level", "Lvl", "MobLevel", "NpcLevel", "Lv"}) do
		local val = model:GetAttribute(attrName) or (hum and hum:GetAttribute(attrName))
		if type(val) == "number" and val > 0 then
			return tostring(math.floor(val))
		elseif type(val) == "string" then
			local num = val:match("%d+")
			if num then return num end
		end
	end

	if hum and hum.DisplayName and hum.DisplayName ~= "" then
		local lvFromDisp = hum.DisplayName:match("[Ll][Vv]%a*%.?%s*(%d+)") or hum.DisplayName:match("%[(%d+)%]")
		if lvFromDisp then
			return lvFromDisp
		end
	end

	for _, desc in ipairs(model:GetDescendants()) do
		if desc:IsA("TextLabel") and desc.Text and desc.Text ~= "" then
			local txt = desc.Text
			local lvMatch = txt:match("[Ll][Vv]%a*%.?%s*(%d+)") or txt:match("%[(%d+)%]") or txt:match("^%d+$")
			if lvMatch then
				return lvMatch
			end
		end
	end

	return nil
end

local function ScanWorldMobs(force)
	if not force and (os.clock() - LastMobScan < 0.75) then
		return CachedAliveByName
	end
	LastMobScan = os.clock()

	local aliveMap = {}
	local counts = {}

	local function collectFrom(container, recordAlive)
		if not container then return end
		for _, obj in ipairs(container:GetDescendants()) do
			if obj:IsA("Model") and not Players:GetPlayerFromCharacter(obj) and not IsIgnoredModel(obj) then
				local hum = obj:FindFirstChildOfClass("Humanoid")
				if hum then
					local realName = tostring(obj.Name):gsub("^%s+", ""):gsub("%s+$", "")
					if realName ~= "" then
						UniqueMobSet[realName] = true

						local detectedLv = ExtractMobLevel(obj, hum)
						if detectedLv then
							KnownMobLevels[realName] = detectedLv
						end

						local hrp = obj:FindFirstChild("HumanoidRootPart") or obj.PrimaryPart
						if hrp and hrp:IsA("BasePart") then
							KnownMobPositions[realName] = hrp.CFrame
						end

						if recordAlive and hrp and hrp:IsA("BasePart") and hum.Health > 0 and hum:GetState() ~= Enum.HumanoidStateType.Dead then
							aliveMap[realName] = aliveMap[realName] or {}
							table.insert(aliveMap[realName], {
								model = obj,
								hum = hum,
								hrp = hrp
							})
							counts[realName] = (counts[realName] or 0) + 1
						end
					end
				end
			end
		end
	end

	for _, root in ipairs(GetScanRoots()) do
		collectFrom(root, true)
	end
	local repMobs = ReplicatedStorage:FindFirstChild("Enemies") or ReplicatedStorage:FindFirstChild("Mobs")
	if repMobs then
		collectFrom(repMobs, false)
	end

	CachedAliveByName = aliveMap
	return aliveMap, counts
end

--// ==========================================
--// JANELA PRINCIPAL RAYFIELD
--// ==========================================
local Window = Rayfield:CreateWindow({
	Name = "Sailor Piece Hub | Sea 2",
	LoadingTitle = "Carregando Hub...",
	LoadingSubtitle = "Multi-Mob • TP Bypass • 450 Range",
	ConfigurationSaving = { Enabled = false },
	KeySystem = false
})

local FarmTab = Window:CreateTab("Auto Farm", 4483362458)
local CombatTab = Window:CreateTab("Combate & Range", 4483362458)

local function BuildMobList()
	table.clear(LabelToRealName)
	local _, counts = ScanWorldMobs(true)

	local sortedUnique = {}
	local seenNorm = {}
	for realName in pairs(UniqueMobSet) do
		local norm = realName:lower()
		if not seenNorm[norm] then
			seenNorm[norm] = true
			table.insert(sortedUnique, realName)
		end
	end
	table.sort(sortedUnique, function(a, b)
		return a:lower() < b:lower()
	end)

	local displayList = {}
	for _, realName in ipairs(sortedUnique) do
		local lvStr = KnownMobLevels[realName] and (" [Lv." .. KnownMobLevels[realName] .. "]") or " [Lv.?]"
		local aliveCount = (counts and counts[realName]) or 0
		local statusStr = aliveCount > 0 and (" (" .. aliveCount .. ")") or " (Outra Ilha)"
		local label = realName .. lvStr .. statusStr

		LabelToRealName[label] = realName
		table.insert(displayList, label)
	end

	if #displayList == 0 then
		table.insert(displayList, "Nenhum mob encontrado")
	end
	return displayList
end

--// ==========================================
--// ABA 1: AUTO FARM & TP BYPASS ENTRE ILHAS
--// ==========================================
local MobDropdown = FarmTab:CreateDropdown({
	Name = "Selecionar Mobs (Nome + Nível)",
	Options = BuildMobList(),
	CurrentOption = {},
	MultipleOptions = true,
	Flag = "MultiMobSelect",
	Callback = function(SelectedOptions)
		local cleanList = {}
		local seen = {}
		for _, label in ipairs(SelectedOptions or {}) do
			local real = LabelToRealName[label]
			if real and not seen[real:lower()] then
				seen[real:lower()] = true
				table.insert(cleanList, real)
			end
		end
		getgenv().HubConfig.SelectedMobs = cleanList
	end,
})

FarmTab:CreateButton({
	Name = "Atualizar Lista (Sem Repetir)",
	Callback = function()
		local updated = BuildMobList()
		pcall(function() MobDropdown:Refresh(updated) end)
		pcall(function()
			Rayfield:Notify({
				Title = "Lista Atualizada",
				Content = #updated .. " mobs únicos listados.",
				Duration = 3
			})
		end)
	end,
})

